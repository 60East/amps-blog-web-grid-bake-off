{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "sourceMap": true,
    "emitDecoratorMetadata": true,
    "allowJs": true,
    "experimentalDecorators": true,
    "removeComments": false,
    "noImplicitAny": false,
    "strict": false,
    "skipLibCheck": true,
    "lib": ["webworker", "dom", "es2015", "scripthost"]
  },
  "compileOnSave": true,
  "exclude": [
    "node_modules/*"
  ]
}
